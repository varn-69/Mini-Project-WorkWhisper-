# Database Configuration
# Default: SQLite (no additional setup required)
# Alternative: PostgreSQL (uncomment and configure)
DATABASE_URL=sqlite:///./job_recommendation.db
# DATABASE_URL=postgresql://user:password@localhost:5432/job_recommendation

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Adzuna API Configuration (Optional)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Jooble API Configuration (Optional)
JOOBLE_API_KEY=your_jooble_api_key

# USAJOBS API Configuration (Optional)
USAJOBS_API_KEY=your_usajobs_api_key
USAJOBS_EMAIL=your_email@example.com
